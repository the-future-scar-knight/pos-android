# ── Release signing config (TEMPLATE) ──────────────────────────────────────
# Copy this file to `keystore.properties` (same folder) and fill in real values.
# The real keystore.properties and the .jks file are git-ignored — never commit
# them. Until keystore.properties exists, the release build falls back to debug
# signing so it still assembles.
#
# 1. Generate a keystore ONCE (keep the .jks + these passwords somewhere safe —
#    losing them means you can never ship an update to the same app listing):
#
#      keytool -genkeypair -v -keystore spot-pos-release.jks \
#        -alias spot-pos -keyalg RSA -keysize 2048 -validity 10000
#
#    Put spot-pos-release.jks in the pos-android/ folder (next to this file).
#
# 2. Copy this file to keystore.properties and set the four values below.

storeFile=spot-pos-release.jks
storePassword=CHANGE_ME
keyAlias=spot-pos
keyPassword=CHANGE_ME
